{
  "name": "bluecloud",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:website": "vite build",
    "build:tooldeck": "cd apps/tooldeck && node ../../node_modules/vite/bin/vite.js build",
    "build:quranly": "npm --prefix apps/quranly run build:desktop",
    "prepare:launcher": "node scripts/prepare-launcher.mjs",
    "desktop:tooldeck": "electron apps/tooldeck",
    "desktop:launcher": "electron apps/launcher",
    "package:tooldeck": "npm run build:tooldeck && electron-builder --projectDir apps/tooldeck --win nsis --x64",
    "package:launcher": "npm run prepare:launcher && electron-builder --projectDir apps/launcher --win nsis --x64",
    "package:quranly": "npm run build:quranly && electron-builder --projectDir apps/quranly --win nsis --x64 --config.directories.output=../../artifacts/quranly",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "test:ui": "playwright test --config playwright.config.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "7zip-bin": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
