# Copy to .env and fill in values. Never commit real secrets.

# Google Gemini (Ask AI)
VITE_GEMINI_API_KEY=

# HadithAPI.com (optional; bundled fallbacks if empty)
VITE_HADITH_API_KEY=

# Firebase — rotate keys in Firebase Console if they were ever committed to git
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Play / App Store subscription product IDs
VITE_PRO_PRODUCT_MONTHLY=quranly_pro_monthly
VITE_PRO_PRODUCT_YEARLY=quranly_pro_yearly
